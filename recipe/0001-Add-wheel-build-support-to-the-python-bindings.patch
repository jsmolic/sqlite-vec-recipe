 	$(CC) -Ivendor/ $(CFLAGS) -DSQLITE_CORE -DSQLITE_VEC_STATIC \
@@ -188,7 +192,7 @@ evidence-of:
 test:
 	sqlite3 :memory: '.read test.sql'
 
